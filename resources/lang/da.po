#: src/Factories/AuthorizationProviderFactory.php:166
#, php-format
msgid ""
"The configuration for the authorization provider \"%s\" does not include "
"data for the option \"%s\". Please check the configuration in the following "
"file: data/config.ini.php"
msgstr ""
"Konfigurationen for autorisationsudbyderen \"%s\" inkluderer ikke data for "
"indstillingen \"%s\". Tjek venligst konfigurationen i følgende fil: data/"
"config.ini.php"

#: src/LoginWithAuthorizationProviderAction.php:148
msgid "The requested authorization provider could not be found"
msgstr "Den anmodede autorisationsudbyder kunne ikke findes"

#: src/LoginWithAuthorizationProviderAction.php:165
#, php-format
msgid "Disconnected the user %s from provider: %s"
msgstr "Brugeren %s blev afbrudt fra udbyderen: %s"

#: src/LoginWithAuthorizationProviderAction.php:187
msgid ""
"Failed security check: A user, who is currently not signed in, requested to "
"connect an authorization provider with the current user."
msgstr ""
"Fejlet sikkerhedstjek: En bruger, der ikke er logget ind, forsøgte at "
"forbinde en autorisationsudbyder med brugeren."

#: src/LoginWithAuthorizationProviderAction.php:198
#, php-format
msgid ""
"Timeout for connecting user %s with authorization provider %s. Please "
"restart connecting with the authorization provider."
msgstr ""
"Det tog for lang tid at forbinde bruger %s med autorisationsudbyderen %s. "
"Forsøg venligst igen."

#: src/LoginWithAuthorizationProviderAction.php:232
#: src/LoginWithAuthorizationProviderAction.php:264
msgid "OAuth 2.0 communication error"
msgstr "OAuth 2.0 kommunikationsfejl"

#: src/LoginWithAuthorizationProviderAction.php:236
msgid "Invalid state in communication with authorization provider."
msgstr "Ugyldig kommunikationen med autorisationsudbyderen."

#: src/LoginWithAuthorizationProviderAction.php:268
msgid ""
"Failed to get the access token or the user details from the authorization "
"provider"
msgstr ""
"Kunne ikke hente adgangstoken eller brugeroplysninger fra "
"autorisationsudbyderen"

#: src/LoginWithAuthorizationProviderAction.php:318
msgid ""
"The identity received from the authorization provider cannot be connected to "
"the requested user, because it is already used to sign in by another "
"webtrees user."
msgstr ""
"Den identitet, der er modtaget fra godkendelsesudbyderen, kan ikke forbindes "
"til den anmodede bruger, fordi den allerede bruges til at logge ind af en "
"anden webtrees-bruger."

#: src/LoginWithAuthorizationProviderAction.php:329
#, php-format
msgid "Sucessfully connected existing user %s with provider: %s"
msgstr "Bruger %s blev forbundet med udbyderen: %s"

#: src/LoginWithAuthorizationProviderAction.php:343
msgid ""
"The identity received from the authorization provider is already used to "
"sign in by another webtrees user."
msgstr ""
"Den identitet, der er modtaget fra godkendelsesudbyderen, bruges allerede "
"til at logge ind af en anden Webtrees-bruger."

#: src/LoginWithAuthorizationProviderAction.php:353
msgid ""
"Currently, no webtrees user account is related to the user data received "
"from the authorization provider."
msgstr ""
"Der er i øjeblikket ingen webtrees-brugere, der er knyttet til de "
"brugerdata, der er modtaget fra autorisationsudbyderen."

#: src/LoginWithAuthorizationProviderAction.php:358
#, php-format
msgid "It is not possible to request a webtrees account with %s."
msgstr "Det er ikke muligt at anmode om en webtrees-konto med %s."

#: src/LoginWithAuthorizationProviderAction.php:359
#: src/LoginWithAuthorizationProviderAction.php:366
#: src/LoginWithAuthorizationProviderAction.php:378
#: src/LoginWithAuthorizationProviderAction.php:480
#: src/LoginWithAuthorizationProviderAction.php:489
#, php-format
msgid ""
"To connect an existing user with %s, sign in and select: My pages / My "
"account / Connect with"
msgstr ""
"For at forbinde en eksisterende bruger med %s, log ind og vælg: Mine sider / "
"Min konto / Forbind med"

#: src/LoginWithAuthorizationProviderAction.php:365
#, php-format
msgid "Invalid user data received from %s. Email or username missing."
msgstr "Ugyldige brugerdata modtaget fra %s. Email eller brugernavn mangler."

#: src/LoginWithAuthorizationProviderAction.php:373
msgid "Requesting a new webtrees user account is currently not allowed."
msgstr "Anmodning om en ny webtrees-bruger konto er i øjeblikket ikke tilladt."

#: src/LoginWithAuthorizationProviderAction.php:377
#, php-format
msgid "Press \"continue\" to request a new webtrees user acccount with %s."
msgstr ""
"Tryk på \"Fortsæt\" for at anmode om en ny webtrees-bruger konto med %s."

#: src/LoginWithAuthorizationProviderAction.php:387
msgid "Request a new user account with an authorization provider"
msgstr "Anmod om en ny brugerkonto med en autorisationsudbyder"

#: src/LoginWithAuthorizationProviderAction.php:410
#, php-format
msgid "The email address for user %s was updated to: %s"
msgstr "Emailadressen for bruger %s blev opdateret til: %s"

#: src/LoginWithAuthorizationProviderAction.php:479
#: src/LoginWithAuthorizationProviderAction.php:488
msgid "Login denied. The email address or username already exists."
msgstr "Login nægtet. Emailadressen eller brugernavnet findes allerede."

#: src/OAuth2Client.php:234
msgid "OAuth2 Client"
msgstr "OAuth2-klient"

#: src/OAuth2Client.php:247
msgid "A custom module to implement a OAuth2 client for webtrees."
msgstr "Et modul til at implementere en OAuth2-klient til webtrees."

#: src/OAuth2Client.php:405
msgid "Sign in with"
msgstr "Log ind med"

#: src/OAuth2Client.php:429
msgid "Sign out of"
msgstr "Log ud af"

#: src/OAuth2Client.php:454
msgid "Disconnect account from"
msgstr "Afkobl konto fra"

#: src/OAuth2Client.php:460
msgid "Connect account with"
msgstr "Forbind konto med"

#: src/OAuth2Client.php:606
#, php-format
msgid "The preferences for the module \"%s\" were updated."
msgstr "Indstillingerne for modulet \"%s\" blev opdateret."

#: src/OAuth2Client.php:627
msgid ""
"The redirect URL for OAuth 2.0 communication has changed in custom module "
"versions >= 1.1.0. If certain connections with authorization providers fail, "
"you might need to update the authorization provider settings with the new "
"redirect URL."
msgstr ""
"Redirect-URL'en for OAuth 2.0 kommunikation er ændret i modulversioner >= "
"1.1.0. Hvis visse forbindelser med autorisationsudbydere fejler, skal du "
"muligvis opdatere autorisationsudbyderens indstillinger med den nye redirect-"
"URL."

#: src/OAuth2Client.php:640
#, php-format
msgid ""
"The preferences for the custom module \"%s\" were sucessfully updated to the "
"new module version %s."
msgstr ""
"Indstillingerne for modulet \"%s\" blev succesfuldt opdateret til den nye "
"modulversion %s."

#: src/OAuth2Client.php:672
#, php-format
msgid ""
"The custom module \"%s\" is activated in parallel to the %s custom module. "
"This can lead to unintended behavior. If using the %s module, it is strongly "
"recommended to deactivate the \"%s\" module, because the identical "
"functionality is also integrated in the %s module."
msgstr ""
"Modulet \"%s\" er aktiveret parallelt med %s modulet. Dette kan føre til "
"uønsket adfærd. Hvis du bruger %s modulet, anbefales det stærkt at "
"deaktivere \"%s\" modulet, da den identiske funktionalitet også er "
"integreret i %s modulet."

#: src/OAuth2Client.php:677
#, php-format
msgid ""
"The custom module \"%s\" is activated in parallel to the %s custom module. "
"This can lead to unintended behavior, because both of the modules have "
"registered the same custom view \"%s\". It is strongly recommended to "
"deactivate one of the modules."
msgstr ""
"Modulet \"%s\" er aktiveret parallelt med %s modulet. Dette kan føre til "
"uforudsete problemer, da begge moduler har registreret den samme "
"brugerdefinerede visning \"%s\". Det anbefales på det kraftigste at "
"deaktivere et af modulerne."

#: src/OAuth2Client.php:701
#, php-format
msgid ""
"The custom module view \"%s\" is not registered as replacement for the "
"standard webtrees view. There might be another module installed, which "
"registered the same custom view. This can lead to unintended behavior. It is "
"strongly recommended to deactivate one of the modules. The path of the "
"parallel view is: %s"
msgstr ""
"Modulvisningen \"%s\" er ikke registreret som erstatning for standard "
"webtrees-visningen. Der kan være et andet modul installeret, som har "
"registreret den samme visning. Dette kan føre til uønskede problemer. Det "
"anbefales på det kraftigste at deaktivere et af modulerne. Stien til den "
"parallelle visning er: %s"

#: src/Provider/AbstractAuthorizationProvider.php:161
msgid ""
"Error while trying to get an access token from the authorization provider. "
"Check the setting for urlAccessToken in the webtrees configuration. Check "
"the server access logs for errors. Check the server configuration for "
"redirects."
msgstr ""
"Fejl under forsøg på at hente et adgangstoken fra godkendelsesudbyderen. "
"Kontroller indstillingen for urlAccessToken i webtrees-konfigurationen. "
"Kontroller serveradgangsloggene for fejl. Kontroller serverkonfigurationen "
"for omdirigeringer."

#: src/Provider/AbstractAuthorizationProvider.php:193
#: src/Provider/AutheliaAuthorizationProvider.php:90
#: src/Provider/KanidmAuthorizationProvider.php:90
msgid "Invalid user data received from the authorization provider"
msgstr "Ugyldige brugerdata modtaget fra autorisationsudbyderen"

#: src/Provider/AbstractAuthorizationProvider.php:193
#: src/Provider/AutheliaAuthorizationProvider.php:90
#: src/Provider/KanidmAuthorizationProvider.php:90
msgid ""
"Check the setting for urlResourceOwnerDetails in the webtrees configuration."
msgstr ""
"Tjek indstillingen for urlResourceOwnerDetails i webtrees-konfigurationen."

#: resources/views/alert.phtml:24
msgid "Custom module"
msgstr "Brugerdefineret modul"

#: resources/views/edit-account-page.phtml:66
#, php-format
msgid ""
"The authorization provider \"%s\" is not available. Please contact the "
"webtrees administrator."
msgstr ""
"Autorisationsudbyderen \"%s\" er ikke tilgængelig. Kontakt venligst webtrees-"
"administratoren."

#: resources/views/edit-account-page.phtml:72
#, php-format
msgid "Signed in with %s"
msgstr "Logget ind med %s"

#: resources/views/edit-account-page.phtml:74
#, php-format
msgid "This user can sign in with %s"
msgstr "Denne bruger kan logge ind med %s"

#: resources/views/edit-account-page.phtml:77
msgid ""
"The administrator might have disabled to change the email address or the "
"password"
msgstr ""
"Administratoren kan have deaktiveret muligheden for at ændre emailadressen "
"eller adgangskoden"

#: resources/views/login-with-provider.phtml:29
msgid "Request a new user account with"
msgstr "Anmod om en ny brugerkonto med"

#: resources/views/login-with-provider.phtml:33
msgid "Connect with"
msgstr "Forbind med"

#: resources/views/login-with-provider.phtml:37
msgid "Disconnect from"
msgstr "Afkobl"

#: resources/views/password-request-page.phtml:51
msgid "Sign in with an authorization provider"
msgstr "Log ind med en autorisationsudbyder"

#: resources/views/password-request-page.phtml:54
msgid ""
"In this view, you can only request a webtrees password. The authorization "
"provider password is managed by the authorization provider and cannot be "
"changed within webtrees."
msgstr ""
"I denne visning kan du kun anmode om en webtrees-adgangskode. Adgangskoden "
"til autorisationsudbyderen administreres af autorisationsudbyderen og kan "
"ikke ændres inde i webtrees."

#: resources/views/password-reset-page.phtml:37
msgid ""
"The request to reset the passwort belongs to a user, who can sign in with an "
"authorization provider. In this view, you can only change the webtrees "
"password. The authorization provider password is managed by the "
"authorization provider and cannot be changed within webtrees."
msgstr ""
"Anmodningen om at nulstille adgangskoden tilhører en bruger, der kan logge "
"ind med en autorisationsudbyder. I denne visning kan du kun ændre webtrees-"
"adgangskoden. Adgangskoden til autorisationsudbyderen administreres af "
"autorisationsudbyderen og kan ikke ændres inde i webtrees."

#: resources/views/password-reset-page.phtml:79
msgid ""
"Currently, the webtrees password cannot be reset for users, who sign in with "
"an authorization provider. Please contact the webtrees administrator."
msgstr ""
"I øjeblikket kan webtrees-adgangskoden ikke nulstilles for brugere, der "
"logger ind med en autorisationsudbyder. Kontakt venligst webtrees-"
"administratoren."

#: resources/views/register-page.phtml:68
msgid "Request account with"
msgstr "Anmod om konto med"

#: resources/views/register-page.phtml:68
msgid ""
"The administrator might have disabled to change some of the received user "
"data"
msgstr ""
"Administratoren kan have deaktiveret muligheden for at ændre nogle af de "
"modtagne brugerdata"

#: resources/views/register-page.phtml:138
msgid "Further registration data - Please complete and continue"
msgstr "Yderligere registreringsdata - Udfyld venligst og fortsæt"

#: resources/views/register-with-provider-page.phtml:72
msgid "Request a new account with"
msgstr "Anmod om en ny konto med"

#: resources/views/settings.phtml:32
msgid "Control panel"
msgstr "Kontrolpanel"

#: resources/views/settings.phtml:44
msgid ""
"Currently, webtrees does not use the HTTPS protocol. If signing in with "
"authorization providers, it is urgently recommended to use HTTPS in order to "
"encrypt the communication with the authorization provider. If your server "
"supports the protocol, HTTPS can be activated by changing \"base_url\" in "
"the webtrees \"config.ini.php\" file. Currently, \"base_url\" does not start "
"with \"https://\"."
msgstr ""
"I øjeblikket bruger webtrees ikke HTTPS-protokollen. Hvis du logger ind med "
"autorisationsudbydere, anbefales det kraftigt at bruge HTTPS for at kryptere "
"kommunikationen med autorisationsudbyderen. Hvis din server understøtter "
"protokollen, kan HTTPS aktiveres ved at ændre \"base_url\" i webtrees "
"\"config.ini.php\"-filen. I øjeblikket starter \"base_url\" ikke med "
"\"https://\"."

#: resources/views/settings.phtml:48 resources/views/settings.phtml:50
msgid "Redirect URL"
msgstr "Omdirigerings-URL"

#: resources/views/settings.phtml:65
msgid "Use pretty redirect URL"
msgstr "Brug en smuk omdirigerings-URL"

#: resources/views/settings.phtml:70
msgid ""
"In rare cases, it might be helpful to use a pretty redirect URL. Only "
"activate this option if necessary, e.g. for Authelia as authorization "
"provider."
msgstr ""
"I sjældne tilfælde kan det være nyttigt at bruge en pæn omdirigerings-URL. "
"Aktiver kun denne mulighed, hvis det er nødvendigt, f.eks. for Authelia som "
"autorisationsudbyder."

#: resources/views/settings.phtml:78
msgid "Settings for Sign In Menus"
msgstr "Indstillinger for login-menuer"

#: resources/views/settings.phtml:83
msgid "Currently, the webtrees sign in with Username/Password is deactivated."
msgstr "I øjeblikket er webtrees login med brugernavn/adgangskode deaktiveret."

#: resources/views/settings.phtml:84 resources/views/settings.phtml:89
msgid ""
"Therefore, it is only possible to sign in with an authorization provider. "
"Please be sure to establish a webtrees administrator account with an "
"authorization provider. Otherwise, administrator sign in might not be "
"possible any more."
msgstr ""
"Derfor er det kun muligt at logge ind med en autorisationsudbyder. Sørg for "
"at oprette en webtrees-administratorkonto hos en autorisationsudbyder. "
"Ellers er det muligvis ikke længere muligt at logge ind som administrator."

#: resources/views/settings.phtml:88
msgid ""
"Currently, all menus to directly sign in with a webtrees Username/Password "
"are deactivated."
msgstr ""
"I øjeblikket er alle menuer til direkte login med et Webtrees brugernavn/"
"adgangskode deaktiveret."

#: resources/views/settings.phtml:93
#, php-format
msgid ""
"Currently, the webtrees sign in menu is deactivated and the custom module "
"sign in menu is hidden for the following trees: %s. Some of the users will "
"not be able to sign in. Please consider to activate one of the sign in menus "
"with the settings below."
msgstr ""
"I øjeblikket er webtrees-login-menuen deaktiveret, og den brugerdefinerede "
"modul-login-menu er skjult for følgende træer: %s. Nogle af brugerne vil "
"ikke kunne logge ind. Overvej venligst at aktivere en af login-menuerne med "
"indstillingerne nedenfor."

#: resources/views/settings.phtml:100
msgid "Show original webtrees sign in as menu item"
msgstr "Vis oprindeligt webtrees-login som menuobjekt"

#: resources/views/settings.phtml:105
msgid ""
"By selecting/unselecting this option, it is possible to activate/deactivate "
"the sign in menu entry for webtrees. If deactivated, only sign in menu "
"entries for authorization providers might be shown."
msgstr ""
"Ved at vælge/fravælge denne mulighed kan du aktivere/deaktivere login-"
"menuindgangen. Hvis den deaktiveres, vises der kun login-menuindgange for "
"autorisationsudbydere."

#: resources/views/settings.phtml:114
msgid "Hide the webtrees sign in menu"
msgstr "Skjul webtrees-login-menuen"

#: resources/views/settings.phtml:117 resources/views/settings.phtml:131
msgid "Hide"
msgstr "Skjul"

#: resources/views/settings.phtml:119
msgid ""
"By selecting this option, it is possible to hide the original webtrees sign "
"in menu. This might be helpful if the custom module specific top menu for "
"sign in is used instead."
msgstr ""
"Ved at vælge denne mulighed kan du skjule den oprindelige login-menu. Dette "
"kan være nyttigt, hvis det brugerdefinerede modul-specifikke topmenu til "
"login bruges i stedet."

#: resources/views/settings.phtml:128
msgid "Hide webtrees sign in (with Username/Password) on login page"
msgstr "Skjul webtrees login (med brugernavn/adgangskode) på loginsiden"

#: resources/views/settings.phtml:133
msgid ""
"By selecting this option, it is possible to hide the webtrees sign in (with "
"Username/Password) on the login page."
msgstr ""
"Ved at vælge denne mulighed er det muligt at skjule webtrees login (med "
"brugernavn/adgangskode) på loginsiden."

#: resources/views/settings.phtml:140
msgid "Settings for Password, Email, and Connection Management"
msgstr "Indstillinger for adgangskode, email og forbindelseshåndtering"

#: resources/views/settings.phtml:146
msgid "Keep email address synchronized with authorization provider"
msgstr "Hold emailadressen synkroniseret med autorisationsudbyderen"

#: resources/views/settings.phtml:149
msgid "Keep synchronized"
msgstr "Hold synkroniseret"

#: resources/views/settings.phtml:151
msgid ""
"This selection prevents a user with the same email address in webtrees and "
"at the authorization provider from changing the email address in webtrees. "
"If the email address at the authorization provider changes, the email "
"address in webtrees will be updated during sign in. If the administrator "
"changes the email address in the webtrees user management, the email address "
"synchronization will no longer continue."
msgstr ""
"Denne mulighed forhindrer en bruger med samme emailadresse i webtrees og hos "
"autorisationsudbyderen i at ændre emailadressen i webtrees. Hvis "
"emailadressen hos autorisationsudbyderen ændres, vil emailadressen i "
"webtrees blive opdateret under login. Hvis administratoren ændrer "
"emailadressen i webtrees' brugerstyring, vil email-synkroniseringen ikke "
"fortsætte."

#: resources/views/settings.phtml:160
msgid "Use webtrees password in parallel"
msgstr "Brug webtrees-adgangskode parallelt"

#: resources/views/settings.phtml:165
msgid ""
"This option allows users, who register with an authorization provider, to "
"additionally sign in with a webtrees password."
msgstr ""
"Denne mulighed giver brugere, der registrerer sig med en "
"autorisationsudbyder, mulighed for også at logge ind med en adgangskode."

#: resources/views/settings.phtml:174
msgid "Allow existing webtrees users to connect with an authorization provider"
msgstr ""
"Tillad eksisterende webtrees-brugere at forbinde med en autorisationsudbyder"

#: resources/views/settings.phtml:179
msgid ""
"If selecting this option, an existing webtrees user can connect the webtrees "
"account with an authorization provider. This will allow users to "
"additionally sign in with an authorization providers while still using the "
"webtrees user and password."
msgstr ""
"Hvis denne mulighed vælges, kan en eksisterende bruger forbinde med en "
"autorisationsudbyder. Dette vil give brugeren mulighed for at logge ind med "
"en autorisationsudbyder samtidig med, at webtrees-brugeren og -adgangskoden "
"stadig kan bruges."

#: resources/views/settings.phtml:185
msgid "Debug Settings"
msgstr "Fejlsøgningsindstillinger"

#: resources/views/settings.phtml:191
msgid "Debug logs"
msgstr "Fejlsøgningslogs"

#: resources/views/settings.phtml:196
msgid ""
"By selecting this option, additional debug information about the protocol "
"flow between webtrees and the authorization provider will be logged in the "
"webtrees website logs."
msgstr ""
"Ved at vælge denne mulighed vil yderligere fejlinformation om forbindelsen "
"mellem webtrees og autorisationsudbyderen blive logget i logfilerne."
