{
    "name": "jefferson49/webtrees-oauth2-client",
    "description": "A webtrees custom module to manage custom modules within webtrees",
    "license": [
        "GPL-3.0-or-later"
    ],
    "keywords": [
        "webtrees",
        "custom module"
    ],
    "authors": [
        {
            "name": "Markus Hemprich",
            "homepage": "https://github.com/jefferson49",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/jefferson49/webtrees-oauth2-client",
    "support": {
        "issues": "https://github.com/jefferson49/webtrees-oauth2-client/issues"
    },
    "repositories": [
        {
            "url": "https://github.com/Jefferson49/webtrees-common.git",
            "type": "git"
        },
        {
            "url": "https://github.com/jefferson49/oauth2-kanidm.git",
            "type": "git"
        },
        {
            "url": "https://github.com/jefferson49/oauth2-authelia.git",
            "type": "git"
        }
    ],
    "require": {
        "php": ">=7.4",
        "bahuma/oauth2-nextcloud": "=2.1.0",
        "jefferson49/oauth2-authelia": ">=1.0.0",
        "jefferson49/oauth2-kanidm": ">=1.1.1",
        "jefferson49/webtrees-common": ">=1.2.44",
        "league/oauth2-client": "=2.9.0",
        "league/oauth2-github": "=3.1.1",
        "league/oauth2-google": "=4.2.0",
        "stevenmaguire/oauth2-dropbox": "=3.1.0",
        "stevenmaguire/oauth2-keycloak": "=5.1.0"
    },
    "replace": {
        "firebase/php-jwt": "*",
        "guzzlehttp/guzzle": "*",
        "paragonie/random_compat": "*"
    },
    "conflict": {
        "fisharebest/webtrees": "<2.1"
    },
    "config": {
        "prepend-autoloader": false
    }
}